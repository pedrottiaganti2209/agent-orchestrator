{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "dashboardName": {
      "type": "string",
      "defaultValue": "Migration-Dashboard"
    },
    "moduleName": {
      "type": "string",
      "defaultValue": "CALCJURO"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "appInsightsResourceId": {
      "type": "string"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Portal/dashboards",
      "apiVersion": "2020-09-01-preview",
      "name": "[parameters('dashboardName')]",
      "location": "[parameters('location')]",
      "tags": {
        "hidden-title": "[parameters('dashboardName')]",
        "migrated-module": "[parameters('moduleName')]"
      },
      "properties": {
        "lenses": [
          {
            "order": 0,
            "parts": [
              {
                "position": { "x": 0, "y": 0, "colSpan": 4, "rowSpan": 3 },
                "metadata": {
                  "type": "Extension/Microsoft_Azure_Monitoring/PartType/MetricsChartPart",
                  "settings": {
                    "title": "Error Rate (%)",
                    "metrics": [
                      {
                        "resourceMetadata": { "id": "[parameters('appInsightsResourceId')]" },
                        "name": "requests/failed",
                        "aggregationType": 4,
                        "namespace": "microsoft.insights/components"
                      }
                    ],
                    "timespan": { "relative": { "duration": 3600000 } },
                    "visualization": { "chartType": 2 }
                  }
                }
              },
              {
                "position": { "x": 4, "y": 0, "colSpan": 4, "rowSpan": 3 },
                "metadata": {
                  "type": "Extension/Microsoft_Azure_Monitoring/PartType/MetricsChartPart",
                  "settings": {
                    "title": "Latência P99 (ms)",
                    "metrics": [
                      {
                        "resourceMetadata": { "id": "[parameters('appInsightsResourceId')]" },
                        "name": "requests/duration",
                        "aggregationType": 90,
                        "namespace": "microsoft.insights/components"
                      }
                    ],
                    "timespan": { "relative": { "duration": 3600000 } },
                    "visualization": { "chartType": 2 }
                  }
                }
              },
              {
                "position": { "x": 8, "y": 0, "colSpan": 4, "rowSpan": 3 },
                "metadata": {
                  "type": "Extension/Microsoft_Azure_Monitoring/PartType/MetricsChartPart",
                  "settings": {
                    "title": "Parity Delta Count",
                    "metrics": [
                      {
                        "resourceMetadata": { "id": "[parameters('appInsightsResourceId')]" },
                        "name": "customMetrics/parity_delta_count",
                        "aggregationType": 1,
                        "namespace": "microsoft.insights/components"
                      }
                    ],
                    "timespan": { "relative": { "duration": 86400000 } },
                    "visualization": { "chartType": 2 }
                  }
                }
              },
              {
                "position": { "x": 0, "y": 3, "colSpan": 12, "rowSpan": 4 },
                "metadata": {
                  "type": "Extension/Microsoft_Azure_Monitoring/PartType/LogsDashboardPart",
                  "settings": {
                    "title": "Últimas Execuções do Orquestrador",
                    "query": "traces | where customDimensions.module_name == '[parameters('moduleName')]' | order by timestamp desc | take 20 | project timestamp, message, customDimensions",
                    "resourceIds": ["[parameters('appInsightsResourceId')]"]
                  }
                }
              }
            ]
          }
        ],
        "metadata": {
          "model": {
            "timeRange": {
              "value": { "relative": { "duration": 24, "timeUnit": 1 } },
              "type": "MsPortalFx.Composition.Configuration.ValueTypes.TimeRange"
            }
          }
        }
      }
    }
  ]
}
