# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Azure - Principal de Serviço
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret

# Azure Container Registry
ACR_LOGIN_SERVER=yourregistry.azurecr.io
ACR_NAME=yourregistry

# Azure Kubernetes Service
AKS_CLUSTER_NAME=migration-aks
AKS_RESOURCE_GROUP=migration-rg

# Azure DevOps
AZURE_DEVOPS_ORG=https://dev.azure.com/your-org
AZURE_DEVOPS_PROJECT=mainframe-migration
AZURE_DEVOPS_PAT=your-pat-token

# Azure Cache for Redis (Premium - com persistência)
REDIS_CONNECTION_STRING=your-redis.redis.cache.windows.net:6380,password=...,ssl=True,abortConnect=False

# Azure Cosmos DB
COSMOS_ENDPOINT=https://your-cosmos.documents.azure.com:443/
COSMOS_KEY=your-cosmos-key==
COSMOS_DATABASE=migration-db
COSMOS_CONTAINER=migration-history

# GitHub
GITHUB_TOKEN=ghp_...
GITHUB_REPO=your-org/your-repo
GITHUB_DEFAULT_BRANCH=main

# SonarQube
SONARQUBE_URL=https://sonarqube.interno
SONARQUBE_TOKEN=sqa_...
SONARQUBE_PROJECT_KEY=mainframe-migration

# Shadow do Mainframe (endpoint de sombra para parity testing)
MAINFRAME_SHADOW_ENDPOINT=https://mainframe-shadow.interno/api
MAINFRAME_SHADOW_API_KEY=your-shadow-key

# Confluence
CONFLUENCE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_TOKEN=your-confluence-token
CONFLUENCE_SPACE_KEY=MAINT

# Configurações do orquestrador
PARITY_TOLERANCE=0.001
MAX_RETRY_ATTEMPTS=3
PIPELINE_TIMEOUT_MINUTES=20
AGENT_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO
